[Unit]
Description=CRANGE static documentation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/var/www/crange-docs
ExecStart=/usr/bin/python3 -m http.server 8769 --bind 0.0.0.0 --directory /var/www/crange-docs
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
